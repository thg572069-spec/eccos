
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eccos",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "workers_dev": true,

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "ECCOS",
        "class_name": "EccosGateway"
      },
      {
        "name": "CONTROL_PLANE",
        "class_name": "EccosControlPlane"
      }
    ]
  },

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "eccos-dnmatias56-media",
      "jurisdiction": "eu"
    }
  ],

  "ratelimits": [
    {
      "name": "SEND_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EccosGateway"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EccosControlPlane"]
    }
  ],

  "vars": {
    "META_GRAPH_VERSION": "v25.0",
    "GATEWAY_PUBLIC_URL": "https://eccos.dnmatias56.workers.dev",
    "FORWARD_MAX_ATTEMPTS": "6",
    "CONTENT_RETENTION_DAYS": "30",
    "DELIVERY_RETENTION_DAYS": "90",
    "DO_JURISDICTION": "eu"
  }
}
